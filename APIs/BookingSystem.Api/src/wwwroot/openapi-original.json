        "parameters" : [ {
          "explode" : false,
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "format" : "int32",
            "type" : "integer"
          },
          "style" : "simple"
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/userDetails"
                }
              }
            },
            "description" : "Successful response."
          }
        },
        "summary" : "Get user by ID",
        "tags" : [ "User" ]
      }
    },
    "/users/list" : {
