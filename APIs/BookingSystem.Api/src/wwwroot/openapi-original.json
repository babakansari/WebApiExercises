        "summary" : "Get list of events",
        "tags" : [ "Event" ]
      },
      "post" : {
        "operationId" : "createEvent",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/event"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/event"
                }
              }
            },
            "description" : "Event created successfully."
          }
        },
        "summary" : "Create a new event",
        "tags" : [ "Event" ]
      }
    },
    "/bookings" : {
      "post" : {
        "operationId" : "createBooking",
        "requestBody" : {
          "content" : {
            "application/json" : {
